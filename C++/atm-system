// ════════════════════════════════════════════════════════════════════════
//  ENCODING  (Caesar +3, pipe-delimited)
// ════════════════════════════════════════════════════════════════════════

string encode(const string& s) {
    string r;
    for (int i = 0; i < (int)s.size(); i++) {
        r += to_string((int)s[i] + 3);
        if (i < (int)s.size()-1) r += "|";
    }
    return r;
}

string decode(const string& e) {
    string r, tok;
    for (int i = 0; i <= (int)e.size(); i++) {
        if (i == (int)e.size() || e[i]=='|') {
            if (!tok.empty()) { r += (char)(stoi(tok)-3); tok = ""; }
        } else tok += e[i];
    }
    return r;
}

