<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Logical-Mathematical Intelligence</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Space+Mono:wght@400;700&display=swap');

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #f5f4f0;
    --ink: #1a1a18;
    --mid: #6b6b66;
    --light: #c8c7c0;
    --paper: #efefea;
    --accent: #2e2e2c;
  }

  html, body {
    width: 100%; height: 100%;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Courier Prime', monospace;
    overflow: hidden;
  }

  /* HEADER */
  header {
    position: fixed; top: 0; left: 0; right: 0;
    z-index: 100;
    padding: 18px 32px;
    display: flex; align-items: center; justify-content: space-between;
    background: var(--bg);
    border-bottom: 1px solid var(--light);
  }
  header .logo {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--mid);
  }
  header .title {
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--ink);
    text-transform: uppercase;
  }
  header .hint {
    font-size: 10px;
    color: var(--mid);
    letter-spacing: 0.15em;
  }

  /* CANVAS */
  #canvas {
    position: fixed;
    top: 57px; left: 0; right: 0; bottom: 0;
    overflow: hidden;
    cursor: grab;
  }
  #canvas:active { cursor: grabbing; }

  #world {
    position: absolute;
    width: 3200px; height: 2400px;
    transform-origin: 0 0;
  }

  /* SVG LINES */
  #lines {
    position: absolute; top: 0; left: 0;
    width: 100%; height: 100%;
    pointer-events: none;
  }

  /* NODES */
  .node {
    position: absolute;
    transform: translate(-50%, -50%);
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .node:hover .node-box { border-color: var(--ink); }

  .node-box {
    background: var(--bg);
    border: 1px solid var(--light);
    padding: 10px 16px;
    transition: border-color 0.2s, box-shadow 0.2s;
    position: relative;
  }
  .node-box:hover {
    box-shadow: 3px 3px 0 var(--ink);
  }

  .node-label {
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--mid);
    display: block;
    margin-bottom: 4px;
  }

  .node-title {
    font-family: 'Courier Prime', monospace;
    font-weight: 700;
    font-size: 14px;
    color: var(--ink);
    white-space: nowrap;
  }

  .node-sub {
    font-size: 11px;
    color: var(--mid);
    margin-top: 4px;
    line-height: 1.5;
    max-width: 180px;
  }

  /* CENTER NODE */
  .node-center .node-box {
    background: var(--ink);
    border-color: var(--ink);
    padding: 20px 32px;
  }
  .node-center .node-label { color: var(--light); }
  .node-center .node-title {
    color: var(--bg);
    font-size: 18px;
  }
  .node-center .node-sub { color: var(--light); max-width: 220px; }

  /* BRANCH COLORS (all monochrome variations) */
  .branch-a .node-box { border-color: var(--ink); }
  .branch-b .node-box { border-style: dashed; }
  .branch-c .node-box { background: var(--paper); }
  .branch-d .node-box { }
  .branch-e .node-box { border-width: 2px; }
  .branch-f .node-box { background: var(--accent); border-color: var(--accent); }
  .branch-f .node-title { color: var(--bg); }
  .branch-f .node-label { color: var(--light); }

  /* TOOLTIP */
  .tooltip {
    position: fixed;
    bottom: 24px; left: 50%;
    transform: translateX(-50%);
    background: var(--ink);
    color: var(--bg);
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    padding: 8px 18px;
    letter-spacing: 0.1em;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s;
    z-index: 200;
  }
  .tooltip.show { opacity: 1; }

  /* COUNTER */
  .node-counter {
    position: absolute;
    top: -8px; right: -8px;
    width: 18px; height: 18px;
    background: var(--ink);
    color: var(--bg);
    font-family: 'Space Mono', monospace;
    font-size: 9px;
    display: flex; align-items: center; justify-content: center;
    letter-spacing: 0;
    border-radius: 0;
  }

  /* ZOOM CONTROLS */
  .zoom-controls {
    position: fixed;
    bottom: 24px; right: 24px;
    display: flex; gap: 1px;
    z-index: 200;
  }
  .zoom-btn {
    width: 36px; height: 36px;
    background: var(--ink);
    color: var(--bg);
    border: none;
    font-family: 'Space Mono', monospace;
    font-size: 16px;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.2s;
  }
  .zoom-btn:hover { background: var(--mid); }

  /* LEGEND */
  .legend {
    position: fixed;
    top: 80px; right: 24px;
    z-index: 100;
    font-family: 'Space Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.12em;
    color: var(--mid);
    line-height: 2;
    text-transform: uppercase;
  }
  .legend-item {
    display: flex; align-items: center; gap: 8px;
  }
  .legend-dot {
    width: 12px; height: 1px;
    background: var(--mid);
  }
  .legend-dot.solid { height: 1px; }
  .legend-dot.dashed { border-top: 1px dashed var(--mid); background: none; }

  /* INTRO FADE */
  @keyframes fadeUp {
    from { opacity: 0; transform: translate(-50%, calc(-50% + 12px)); }
    to   { opacity: 1; transform: translate(-50%, -50%); }
  }
  .node { animation: fadeUp 0.5s ease both; }
</style>
</head>
<body>

<header>
  <span class="logo">CIFP 102 — Pre-final</span>
  <span class="title">Logical-Mathematical Intelligence</span>
  <span class="hint">drag · scroll to zoom</span>
</header>

<div id="canvas">
  <div id="world">
    <svg id="lines" xmlns="http://www.w3.org/2000/svg"></svg>
    <!-- nodes injected by JS -->
  </div>
</div>

<div class="tooltip" id="tooltip"></div>

<div class="zoom-controls">
  <button class="zoom-btn" id="zoomOut">−</button>
  <button class="zoom-btn" id="zoomIn">+</button>
</div>

<div class="legend">
  <div class="legend-item"><span class="legend-dot solid"></span> main branch</div>
  <div class="legend-item"><span class="legend-dot dashed"></span> sub-branch</div>
</div>

<script>
// ─── DATA ───────────────────────────────────────────────────────────────────
