    sub: 'Primes · Proofs\nModular arithmetic',
    cls: '', branch: 'c', delay: 150,
    tooltip: 'The study of integers and their relationships.'
  },
  {
    id: 'math-2', x: 2520, y: 820,
    label: '',
    title: 'Discrete Math',
    sub: 'Logic · Sets · Graphs\nCombinatorics',
    cls: '', branch: 'c', delay: 200,
    tooltip: 'The mathematics underlying computer science.'
  },
  {
    id: 'math-3', x: 2340, y: 1000,
    label: '',
    title: 'Statistics',
    sub: 'Probability · Inference\nData analysis',
    cls: '', branch: 'c', delay: 250,
    tooltip: 'Mathematical reasoning under uncertainty.'
  },
  {
    id: 'math-4', x: 2680, y: 680,
    label: '',
    title: 'Calculus',
    sub: 'Rates of change\nAreas & integrals',
    cls: '', branch: 'c', delay: 300,
    tooltip: 'The mathematics of continuous change.'
  },

  // ── BRANCH 4: ANALYTICAL THINKING ───────────────────────────────
  {
    id: 'think', x: 2240, y: 1680,
    label: '04 — Mindset',
    title: 'ANALYTICAL THINKING',
    sub: 'Reasoning from\nevidence to truth',
    cls: '', branch: 'e', delay: 100,
    tooltip: 'The ability to break complex problems into logical components.'
  },
  {
    id: 'think-1', x: 2520, y: 1540,
    label: '',
    title: 'Critical Thinking',
    sub: 'Evaluate claims\nQuestion assumptions',
    cls: '', branch: 'e', delay: 150,
    tooltip: 'Disciplined thinking that seeks evidence and sound reasoning.'
  },
  {
    id: 'think-2', x: 2580, y: 1780,
    label: '',
    title: 'Systems Thinking',
    sub: 'See wholes, not\njust parts',
    cls: '', branch: 'e', delay: 200,
    tooltip: 'Understanding how components interact in complex systems.'
  },
  {
    id: 'think-3', x: 2440, y: 1960,
    label: '',
    title: 'Deductive Logic',
    sub: 'If A → B, A ∴ B',
    cls: '', branch: 'e', delay: 250,
    tooltip: 'Drawing valid conclusions from premises.'
  },
  {
    id: 'think-4', x: 2680, y: 1640,
    label: '',
    title: 'Scientific Method',
    sub: 'Hypothesis\nTest · Conclude',
    cls: '', branch: 'e', delay: 300,
    tooltip: 'Structured empirical investigation.'
  },

  // ── BRANCH 5: LEARNING STRATEGIES ───────────────────────────────
  {
    id: 'learn', x: 1600, y: 560,
    label: '05 — Method',
    title: 'LEARNING STYLE',
    sub: 'How logical minds\nbest absorb knowledge',
    cls: '', branch: 'f', delay: 100,
    tooltip: 'Logical-mathematical learners thrive with structure, patterns, and classification.'
  },
  {
    id: 'learn-1', x: 1380, y: 360,
    label: '',
    title: 'Structured Notes',
    sub: 'Outlines · Tables\nFlowcharts',
    cls: '', branch: 'a', delay: 150,
    tooltip: 'Organizing information hierarchically matches logical brain patterns.'
  },
  {
    id: 'learn-2', x: 1600, y: 280,
    label: '',
    title: 'Practice Problems',
    sub: 'Repetition builds\nlogical muscle',
    cls: '', branch: 'a', delay: 200,
    tooltip: 'Active problem-solving reinforces mathematical reasoning.'
  },
  {
    id: 'learn-3', x: 1820, y: 360,
    label: '',
    title: 'Mind Mapping',
    sub: 'Visual connections\nbetween concepts',
    cls: '', branch: 'a', delay: 250,
    tooltip: 'Like this very diagram — connecting ideas spatially.'
  },
  {
    id: 'learn-4', x: 1980, y: 480,
    label: '',
    title: 'Teach to Learn',
    sub: 'Explaining forces\ndeep understanding',
    cls: '', branch: 'a', delay: 300,
    tooltip: 'The Feynman Technique — if you can\'t explain it simply, you don\'t understand it.'
  },

  // ── BRANCH 6: MOTIVATION ─────────────────────────────────────────
  {
    id: 'motiv', x: 1600, y: 1840,
    label: '06 — Drive',
    title: 'MOTIVATION',
    sub: 'What fuels the\nlogical mind',
    cls: '', branch: 'd', delay: 100,
    tooltip: 'Achievement motivation drives logical-mathematical intelligence to excel.'
  },
  {
    id: 'motiv-1', x: 1380, y: 2040,
    label: '',
    title: 'Challenge',
    sub: 'Hard problems\nignite curiosity',
    cls: '', branch: 'd', delay: 150,
    tooltip: 'Mastery orientation — the joy of solving difficult problems.'
  },
  {
    id: 'motiv-2', x: 1600, y: 2120,
    label: '',
    title: 'Curiosity',
    sub: 'Why does this\nalways work?',
    cls: '', branch: 'd', delay: 200,
    tooltip: 'Intrinsic motivation through the love of understanding.'
  },
  {
    id: 'motiv-3', x: 1820, y: 2040,
    label: '',
    title: 'Mastery',
    sub: 'Progress toward\nperfect execution',
    cls: '', branch: 'd', delay: 250,
    tooltip: 'The satisfaction of moving from novice to expert.'
  },
];

// ─── CONNECTIONS ────────────────────────────────────────────────────────────
const edges = [
  // main branches from root
  { from: 'root', to: 'prog', thick: true },
  { from: 'root', to: 'chess', thick: true },
  { from: 'root', to: 'math', thick: true },
  { from: 'root', to: 'think', thick: true },
  { from: 'root', to: 'learn', thick: true },
  { from: 'root', to: 'motiv', thick: true },
  // programming
  { from: 'prog', to: 'prog-1' },
  { from: 'prog', to: 'prog-2' },
  { from: 'prog', to: 'prog-3' },
  { from: 'prog-1', to: 'prog-4' },
  // chess
  { from: 'chess', to: 'chess-1' },
  { from: 'chess', to: 'chess-2' },
  { from: 'chess', to: 'chess-3' },
  { from: 'chess-1', to: 'chess-4' },
  // math
  { from: 'math', to: 'math-1' },
  { from: 'math', to: 'math-2' },
  { from: 'math', to: 'math-3' },
  { from: 'math-1', to: 'math-4' },
  // analytical
  { from: 'think', to: 'think-1' },
  { from: 'think', to: 'think-2' },
  { from: 'think', to: 'think-3' },
  { from: 'think-1', to: 'think-4' },
  // learning
  { from: 'learn', to: 'learn-1' },
  { from: 'learn', to: 'learn-2' },
  { from: 'learn', to: 'learn-3' },
  { from: 'learn', to: 'learn-4' },
  // motivation
  { from: 'motiv', to: 'motiv-1' },
  { from: 'motiv', to: 'motiv-2' },
  { from: 'motiv', to: 'motiv-3' },
  // cross-links
  { from: 'prog', to: 'math', dashed: true },
  { from: 'chess', to: 'think', dashed: true },
  { from: 'learn', to: 'motiv', dashed: true },
];

// ─── BUILD DOM ──────────────────────────────────────────────────────────────
const world = document.getElementById('world');
const svg   = document.getElementById('lines');
const tooltip = document.getElementById('tooltip');

const nodeMap = {};

nodes.forEach((n, i) => {
  const div = document.createElement('div');
  div.className = `node ${n.cls || ''} ${n.branch ? 'branch-' + n.branch : ''}`;
  div.style.left = n.x + 'px';
  div.style.top  = n.y + 'px';
  div.style.animationDelay = (n.delay || 0) + 'ms';
  div.dataset.id = n.id;

  div.innerHTML = `
    <div class="node-box">
      ${i > 0 ? `<span class="node-counter">${String(i).padStart(2,'0')}</span>` : ''}
      ${n.label ? `<span class="node-label">${n.label}</span>` : ''}
      <span class="node-title">${n.title}</span>
      ${n.sub ? `<div class="node-sub">${n.sub}</div>` : ''}
    </div>
  `;

  div.addEventListener('mouseenter', () => {
    tooltip.textContent = n.tooltip;
    tooltip.classList.add('show');
  });
  div.addEventListener('mouseleave', () => {
    tooltip.classList.remove('show');
  });

  world.appendChild(div);
  nodeMap[n.id] = { el: div, data: n };
});

// ─── DRAW EDGES ─────────────────────────────────────────────────────────────
function getCenter(n) {
  return { x: n.x, y: n.y };
}

function curvePath(ax, ay, bx, by) {
  const mx = (ax + bx) / 2;
  const my = (ay + by) / 2;
  const cx1 = mx + (ay - by) * 0.18;
  const cy1 = my + (bx - ax) * 0.18;
  return `M ${ax} ${ay} Q ${cx1} ${cy1} ${bx} ${by}`;
}

edges.forEach(e => {
  const a = nodeMap[e.from].data;
  const b = nodeMap[e.to].data;
  const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
  path.setAttribute('d', curvePath(a.x, a.y, b.x, b.y));
  path.setAttribute('fill', 'none');
  path.setAttribute('stroke', e.dashed ? '#c8c7c0' : '#6b6b66');
  path.setAttribute('stroke-width', e.thick ? '1.5' : '1');
  if (e.dashed) path.setAttribute('stroke-dasharray', '5 5');
  svg.appendChild(path);
});

// ─── PAN & ZOOM ─────────────────────────────────────────────────────────────
let scale = 0.42;
let tx = -340, ty = -260;
let dragging = false, sx = 0, sy = 0, stx = 0, sty = 0;

function applyTransform() {
  world.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
}
applyTransform();

const canvas = document.getElementById('canvas');

canvas.addEventListener('mousedown', e => {
  dragging = true; sx = e.clientX; sy = e.clientY; stx = tx; sty = ty;
});
window.addEventListener('mouseup', () => dragging = false);
window.addEventListener('mousemove', e => {
  if (!dragging) return;
  tx = stx + (e.clientX - sx);
  ty = sty + (e.clientY - sy);
  applyTransform();
});

canvas.addEventListener('wheel', e => {
  e.preventDefault();
  const delta = e.deltaY > 0 ? -0.04 : 0.04;
  scale = Math.max(0.2, Math.min(1.8, scale + delta));
  applyTransform();
}, { passive: false });

document.getElementById('zoomIn').onclick  = () => { scale = Math.min(1.8, scale + 0.08); applyTransform(); };
document.getElementById('zoomOut').onclick = () => { scale = Math.max(0.2, scale - 0.08); applyTransform(); };

// touch support
let lastDist = null;
canvas.addEventListener('touchstart', e => {
  if (e.touches.length === 1) {
    dragging = true;
    sx = e.touches[0].clientX; sy = e.touches[0].clientY;
    stx = tx; sty = ty;
  }
}, { passive: true });
canvas.addEventListener('touchend', () => { dragging = false; lastDist = null; });
canvas.addEventListener('touchmove', e => {
  if (e.touches.length === 1 && dragging) {
    tx = stx + (e.touches[0].clientX - sx);
    ty = sty + (e.touches[0].clientY - sy);
    applyTransform();
  } else if (e.touches.length === 2) {
    const d = Math.hypot(
      e.touches[0].clientX - e.touches[1].clientX,
      e.touches[0].clientY - e.touches[1].clientY
    );
    if (lastDist) { scale = Math.max(0.2, Math.min(1.8, scale * d / lastDist)); applyTransform(); }
    lastDist = d;
  }
}, { passive: true });
</script>
</body>
</html>
